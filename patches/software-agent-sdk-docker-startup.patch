+def test_failed_constructor_stops_its_container():
+    def fail_after_container_start(workspace, image, context):
+        workspace._container_id = "failed-startup-container"
+        raise RuntimeError("Container failed to become healthy in time")
+
+    with (
+        patch.object(
+            DockerWorkspace, "_start_container", new=fail_after_container_start
+        ),
+        patch("openhands.workspace.docker.workspace.execute_command") as execute,
+    ):
+        execute.return_value = Mock(returncode=0, stdout="", stderr="")
+        with pytest.raises(RuntimeError, match="Container failed"):
+            DockerWorkspace(server_image="test:latest")
+        execute.assert_called_once_with(["docker", "stop", "failed-startup-container"])
+
+
+def test_cleanup_from_log_thread_does_not_join_itself(mock_docker_workspace):
+    workspace, execute = mock_docker_workspace()
+    current = threading.current_thread()
+    workspace._logs_thread = current
+    with patch.object(current, "join") as join:
+        workspace.cleanup()
+    join.assert_not_called()
+    execute.assert_called_once_with(["docker", "stop", "container_id_123"])
+    assert workspace._container_id is None
+
+
+def test_health_timeout_preserves_connection_error_and_container_id(
+    mock_docker_workspace,
+):
+    workspace, execute = mock_docker_workspace()
+    workspace.host = "http://127.0.0.1:30379"
+    execute.return_value = Mock(returncode=0, stdout="true", stderr="")
+    error = URLError("connection refused")
+    with (
+        patch("openhands.workspace.docker.workspace.urlopen", side_effect=error),
+        patch(
+            "openhands.workspace.docker.workspace.time.monotonic",
+            side_effect=[0, 0, 2],
+        ),
+        patch("openhands.workspace.docker.workspace.time.sleep"),
+    ):
+        with pytest.raises(RuntimeError, match="Container failed") as failure:
+            workspace._wait_for_health(timeout=1)
+    message = str(failure.value)
+    assert "container=container_id_123" in message
+    assert "health_url=http://127.0.0.1:30379/health" in message
+    assert "last_error=URLError: <urlopen error connection refused>" in message
+    assert failure.value.__cause__ is error
+
