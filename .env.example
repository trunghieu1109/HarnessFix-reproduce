# Copy this file to .env and fill in your own credentials.

# Qwen through an OpenAI-compatible endpoint such as self-hosted vLLM.
# OPENAI_* and the openai/ prefix select its API protocol; the model is Qwen.
# For vLLM, set VLLM_MODEL to "openai/<id returned by GET /v1/models>".
# Example:
#   VLLM_MODEL=openai/Qwen/Qwen3-Coder-30B-A3B-Instruct
#   OPENAI_API_KEY=EMPTY
#   OPENAI_API_BASE=http://192.168.1.20:8000/v1
# Leave OPENAI_API_BASE empty when using the native Gemini route.
VLLM_MODEL=openai/qwen-vllm
OPENAI_API_KEY=
OPENAI_API_BASE=

# Written by scripts/configure_models.py.
# These IDs select task and analysis models independently, including Gemini.
# HARNESSFIX_TASK_MODEL=openai/<qwen-served-model-id>
# HARNESSFIX_ANALYSIS_MODEL=gemini/<gemini-model-id>
HARNESSFIX_MODEL_NAME=qwen-vllm
# HARNESSFIX_ANALYSIS_MODEL_NAME=gemini-api
HARNESSFIX_MAX_OUTPUT_TOKENS=4096
# HARNESSFIX_MODEL_TEMPERATURE=0.0
BETTER_HARNESS_ROOT=../slm-harness-adaptation-reproduce

# Optional generic LiteLLM proxy. Leave empty for direct provider access.
LITELLM_API_KEY=
LITELLM_API_BASE=

# Google AI Studio / Gemini. Use model IDs such as
# gemini/gemini-2.5-flash in HarnessFix CLI commands.
GEMINI_API_KEY=

# Qwen server credential. EMPTY is sufficient when your server has no auth.
QWEN_API_KEY=EMPTY

# GAIA's image tool can use a different multimodal model from the main agent.
# For an all-Qwen setup, point this at a separately served multimodal Qwen.
HARNESSFIX_VISION_MODEL=gemini/gemini-2.5-flash

# Required only for GAIA data download and web search.
HF_TOKEN=
SERPAPI_API_KEY=
SERPER_API_KEY=

# Required only for AppWorld runs.
APPWORLD_ROOT=appworld_root
APPWORLD_AGENT_IMAGE=appworld-agent-pypi:latest
APPWORLD_TASK_CACHE=data/appworld_task_cache.json
